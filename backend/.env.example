# Database (SQLite by default; use postgresql+psycopg2://user:pass@host/db for Postgres)
DATABASE_URL=sqlite:///./shop.db

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Stripe. Leave STRIPE_SECRET_KEY empty to use the built-in MOCK payment page (dev only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# Email. Leave SMTP_HOST empty to just print emails to the console.
# With docker-compose (Mailhog): SMTP_HOST=localhost SMTP_PORT=1025, inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=VOLTA Home <no-reply@volta.local>

# Abandoned cart reminder: send after the cart has been idle this many minutes
ABANDONED_CART_MINUTES=60
REMINDER_CHECK_INTERVAL_MINUTES=5
